<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Straumr.Core\Straumr.Core.csproj"/>
        <ProjectReference Include="..\Straumr.Console.Shared\Straumr.Console.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
        <PackageReference Include="Spectre.Console" Version="0.57.2"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.57.2"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Commands\Autocomplete\Scripts\**\*"/>
        <EmbeddedResource Include="Resources\AutomationHelp.md" LogicalName="Straumr.Console.Cli.AgentDocs.md"/>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="CliRoots.xml"/>
    </ItemGroup>
</Project>
